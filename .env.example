# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Everything is optional for a first look: without Supabase the site renders
# and explains that booking isn't connected yet.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the app (used in emails, magic links, OAuth redirects, cron).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Project Settings → API Keys) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "Publishable key" (sb_publishable_…). Safe in the browser; RLS applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_…). Server only. Bypasses RLS.
SUPABASE_SECRET_KEY=
# Postgres connection string for `npm run db:migrate` / `npm run db:seed`.
# Dashboard → Connect → Session pooler (port 5432). Includes your DB password.
DATABASE_URL=

# ── Access control ──────────────────────────────────────────────────────────
# Comma-separated admin emails. Admins see /admin. Run `npm run admins:sync`
# after editing so admins outside @esdi.edu.es can also sign in.
ADMIN_EMAILS=

# ── Background jobs (Excel sync + emails) ───────────────────────────────────
# Long random string. pg_cron calls /api/jobs/run with it every 5 minutes.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ── Email (booking confirmations) ───────────────────────────────────────────
# console = write .eml files to ./.mail (dev).  smtp = send through SMTP.
EMAIL_TRANSPORT=console
EMAIL_FROM="Taller <reservas@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Microsoft Graph: Excel on OneDrive/SharePoint (optional) ────────────────
# Without these, /admin/excel still downloads an up-to-date .xlsx.
# Delegated sign-in ("Conectar con Microsoft" in /admin). See README.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Drive and item IDs of the workbook (create it with `npm run excel:template`).
MS_DRIVE_ID=
MS_FILE_ID=
# Optional. Default: "offline_access User.Read Files.ReadWrite.All"
MS_GRAPH_SCOPES=
# 32 random bytes, base64. Encrypts the stored Microsoft refresh token.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MS_TOKEN_ENCRYPTION_KEY=

# ── Cosmetic ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WORKSHOP_NAME=Taller
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Development only ────────────────────────────────────────────────────────
# Enables /api/dev/login?as=alumno1@esdi.edu.es (localhost, non-production only).
# Needed by tests/e2e/booking.spec.ts (signs two test students in without email).
ENABLE_DEV_LOGIN=false
